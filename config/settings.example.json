{
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [
        { "type": "command", "command": "python3 ~/.claude/hooks/prompt-logger.py", "timeout": 5 },
        { "type": "command", "command": "python3 ~/.claude/hooks/jejak.py", "timeout": 10 }
      ]}
    ],
    "SessionStart": [
      { "matcher": "startup|resume",
        "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/jejak.py", "timeout": 10 } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/jejak.py", "timeout": 5 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/jejak-extract.py", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Write|NotebookEdit|Artifact",
        "hooks": [ { "type": "command", "command": "python3 ~/.claude/hooks/jejak-artifact.py", "timeout": 10 } ] }
    ]
  }
}
